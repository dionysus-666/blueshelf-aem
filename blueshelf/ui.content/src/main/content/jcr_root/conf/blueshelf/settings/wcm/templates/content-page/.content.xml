<?xml version="1.0" encoding="UTF-8"?>
<!--
  Editable template (AEM "Template Editor" output).
  - jcr:content : template metadata (title, status, allowed paths)
  - structure   : what every page built from this template ALWAYS has (locked header/footer, the root container)
  - initial     : the starting content copied into a NEW page (authors can change it afterwards)
  - policies    : which policy applies to which component in this template (=> allowed components, styles)
-->
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0"
          xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Template">
    <jcr:content jcr:primaryType="nt:unstructured"
        jcr:title="Content Page" jcr:description="Standard BlueShelf content page"
        status="enabled" allowedPaths="[/content/blueshelf(/.*)?]"/>
    <structure jcr:primaryType="cq:Page">
        <jcr:content jcr:primaryType="cq:PageContent" sling:resourceType="blueshelf/components/page" cq:deviceGroups="[mobile/groups/responsive]">
            <root jcr:primaryType="nt:unstructured" sling:resourceType="blueshelf/components/container" editable="{Boolean}true"/>
        </jcr:content>
    </structure>
    <initial jcr:primaryType="cq:Page">
        <jcr:content jcr:primaryType="cq:PageContent" sling:resourceType="blueshelf/components/page"
                     cq:template="/conf/blueshelf/settings/wcm/templates/content-page">
            <root jcr:primaryType="nt:unstructured" sling:resourceType="blueshelf/components/container">
                <hero jcr:primaryType="nt:unstructured" sling:resourceType="blueshelf/components/hero"/>
            </root>
        </jcr:content>
    </initial>
    <policies jcr:primaryType="cq:Page">
        <jcr:content jcr:primaryType="nt:unstructured" sling:resourceType="wcm/core/components/policies/mappings">
            <root jcr:primaryType="nt:unstructured" sling:resourceType="wcm/core/components/policies/mapping"
                  cq:policy="blueshelf/components/container/default">
                <!-- per-component policies inside the root container, keyed by resource type path -->
                <blueshelf jcr:primaryType="nt:unstructured">
                    <components jcr:primaryType="nt:unstructured">
                        <hero jcr:primaryType="nt:unstructured" sling:resourceType="wcm/core/components/policies/mapping" cq:policy="blueshelf/components/hero/default"/>
                        <title jcr:primaryType="nt:unstructured" sling:resourceType="wcm/core/components/policies/mapping" cq:policy="blueshelf/components/base/title/v1/title/default"/>
                        <product-list jcr:primaryType="nt:unstructured" sling:resourceType="wcm/core/components/policies/mapping" cq:policy="blueshelf/components/product-list/default"/>
                    </components>
                </blueshelf>
            </root>
        </jcr:content>
    </policies>
</jcr:root>
