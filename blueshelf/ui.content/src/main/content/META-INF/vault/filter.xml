<?xml version="1.0" encoding="UTF-8"?>
<workspaceFilter version="1.0">
    <!-- /conf = site configuration (templates, policies). Owned by the project, so replace mode. -->
    <filter root="/conf/blueshelf"/>
    <!-- /content = sample pages. mode="update": add/refresh nodes in the package, never delete others.
         In production projects use mode="merge" (seed once, authors own /content afterwards). -->
    <filter root="/content/blueshelf" mode="update"/>
    <!-- author-UI entry points: /editor.html/<page> and /sites.html (AEM has these under /libs; Sling has no /libs UI) -->
    <filter root="/editor"/>
    <filter root="/sites"/>
</workspaceFilter>
