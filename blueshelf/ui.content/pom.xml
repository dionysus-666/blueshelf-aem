<?xml version="1.0" encoding="UTF-8"?>
<!--
  ui.content = MUTABLE content: sample pages under /content/blueshelf (and later /conf).
  Correlation: seed data / fixtures. In prod, authors own /content, so this package uses
  filter mode "merge" => never overwrite/delete what authors changed.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.blueshelf</groupId>
    <artifactId>blueshelf</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>blueshelf.ui.content</artifactId>
  <packaging>content-package</packaging>
  <name>BlueShelf - UI content</name>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.jackrabbit</groupId>
        <artifactId>filevault-package-maven-plugin</artifactId>
        <extensions>true</extensions>
        <configuration>
          <group>com.blueshelf</group>
          <name>blueshelf.ui.content</name>
          <packageType>content</packageType>
          <validatorsSettings>
            <jackrabbit-nodetypes><options><severityForUnknownNodetypes>WARN</severityForUnknownNodetypes></options></jackrabbit-nodetypes>
          </validatorsSettings>
        </configuration>
      </plugin>
      <plugin>
        <groupId>io.wcm.maven.plugins</groupId>
        <artifactId>wcmio-content-package-maven-plugin</artifactId>
        <extensions>true</extensions>
        <configuration>
          <packageManagerName>composum</packageManagerName>
          <serviceURL>http://${sling.host}:${sling.port}/bin/cpm/package.service.html</serviceURL>
          <userId>${sling.user}</userId>
          <password>${sling.password}</password>
          <force>true</force>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>autoInstallPackage</id>
      <build><plugins><plugin>
        <groupId>io.wcm.maven.plugins</groupId>
        <artifactId>wcmio-content-package-maven-plugin</artifactId>
        <executions><execution><id>install-package</id><goals><goal>install</goal></goals></execution></executions>
      </plugin></plugins></build>
    </profile>
  </profiles>
</project>
