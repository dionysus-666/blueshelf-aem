<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0"
          xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured" jcr:title="Product List" sling:resourceType="cq/gui/components/authoring/dialog">
    <content jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <title jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                   fieldLabel="Heading" name="./jcr:title"/>
            <category jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/select"
                   fieldLabel="Category" fieldDescription="Leave empty for all categories" name="./category">
                <items jcr:primaryType="nt:unstructured">
                    <tvs jcr:primaryType="nt:unstructured" text="TVs" value="tvs"/>
                    <laptops jcr:primaryType="nt:unstructured" text="Laptops" value="laptops"/>
                    <headphones jcr:primaryType="nt:unstructured" text="Headphones" value="headphones"/>
                    <appliances jcr:primaryType="nt:unstructured" text="Appliances" value="appliances"/>
                    <gaming jcr:primaryType="nt:unstructured" text="Gaming" value="gaming"/>
                </items>
            </category>
            <limit jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                   fieldLabel="Max products" name="./limit" min="1" max="48"/>
            <sort jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/select"
                   fieldLabel="Sort" name="./sort">
                <items jcr:primaryType="nt:unstructured">
                    <relevance jcr:primaryType="nt:unstructured" text="Relevance" value="relevance"/>
                    <priceAsc jcr:primaryType="nt:unstructured" text="Price: low to high" value="price-asc"/>
                    <priceDesc jcr:primaryType="nt:unstructured" text="Price: high to low" value="price-desc"/>
                    <rating jcr:primaryType="nt:unstructured" text="Top rated" value="rating"/>
                </items>
            </sort>
            <useQueryParam jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                   text="Search results mode (read ?q= from the URL)" name="./useQueryParam" value="{Boolean}true" uncheckedValue="{Boolean}false"/>
            <productPagePath jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                   fieldLabel="Product detail page" fieldDescription="Page that renders a product from the URL suffix" name="./productPagePath" rootPath="/content/blueshelf"/>
        </items>
    </content>
</jcr:root>
