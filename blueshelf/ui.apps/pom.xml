<?xml version="1.0" encoding="UTF-8"?>
<!--
  ui.apps = FileVault content package for /apps/blueshelf (IMMUTABLE code-ish content):
  component definitions, HTL scripts, dialogs, templates, clientlibs.

  Correlation: a content package is a zip of the JCR subtree serialized as XML/files
  ("jcr_root/" = repository root; ".content.xml" = node + properties; plain files = nt:file).
  META-INF/vault/filter.xml says which paths the package OWNS — on install those subtrees are
  REPLACED by the package content (so anything not in the package under a filter root gets deleted!).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.blueshelf</groupId>
    <artifactId>blueshelf</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>blueshelf.ui.apps</artifactId>
  <packaging>content-package</packaging>
  <name>BlueShelf - UI apps</name>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.jackrabbit</groupId>
        <artifactId>filevault-package-maven-plugin</artifactId>
        <extensions>true</extensions>
        <configuration>
          <group>com.blueshelf</group>
          <name>blueshelf.ui.apps</name>
          <packageType>application</packageType>
          <!-- strict validation: catches broken filter/XML before deploy (Cloud Manager does this too) -->
          <validatorsSettings>
            <jackrabbit-nodetypes><options><severityForUnknownNodetypes>WARN</severityForUnknownNodetypes></options></jackrabbit-nodetypes>
          </validatorsSettings>
        </configuration>
      </plugin>
      <plugin>
        <groupId>io.wcm.maven.plugins</groupId>
        <artifactId>wcmio-content-package-maven-plugin</artifactId>
        <extensions>true</extensions>
        <configuration>
          <!-- Composum package manager (Sling Starter). On AEM you'd set packageManagerName=crx and
               serviceURL=http://host:4502/crx/packmgr/service -->
          <packageManagerName>composum</packageManagerName>
          <serviceURL>http://${sling.host}:${sling.port}/bin/cpm/package.service.html</serviceURL>
          <userId>${sling.user}</userId>
          <password>${sling.password}</password>
          <force>true</force>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>com.blueshelf</groupId>
      <artifactId>blueshelf.core</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>autoInstallPackage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>io.wcm.maven.plugins</groupId>
            <artifactId>wcmio-content-package-maven-plugin</artifactId>
            <executions>
              <execution><id>install-package</id><goals><goal>install</goal></goals></execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
